{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "agents": {
    "document-writer": {
      "inheritModelFrom": "session",
      "skills": [
        "maintaining-product-engineering-docs",
        "domain-modeling",
        "humanizer"
      ],
      "mcps": [],
      "description": "Create/edit formal product, technical and management documents, excluding internal agent plans and state.",
      "orchestratorPrompt": "Use document-writer for formal document creation/body edits; it may read its target and assigned references. Keep internal agent plans and state in the main session.",
      "permission": {
        "task": "deny",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "gh_grep_*": "deny",
        "context7_*": "deny"
      }
    },
    "lark-operator": {
      "inheritModelFrom": "session",
      "skills": [],
      "mcps": [],
      "description": "Handle independent Lark reads and platform operations, excluding formal document writing and local file maintenance.",
      "orchestratorPrompt": "Use lark-operator for independent Lark reads/actions; never run platform skills directly. Give Council seats the same retrieved Lark revision. Route local Lark skill files, including lark-skill-maker work, to fixer; operator supplies platform facts and authorized validation only.",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "task": "deny",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "gh_grep_*": "deny",
        "context7_*": "deny"
      }
    },
    "orchestrator": {
      "skills_remove": [
        "humanizer",
        "use-modern-go",
        "lark-approval",
        "lark-apps",
        "lark-attendance",
        "lark-base",
        "lark-calendar",
        "lark-contact",
        "lark-doc",
        "lark-drive",
        "lark-event",
        "lark-im",
        "lark-mail",
        "lark-markdown",
        "lark-meeting",
        "lark-minutes",
        "lark-note",
        "lark-okr",
        "lark-openapi-explorer",
        "lark-shared",
        "lark-sheets",
        "lark-skill-maker",
        "lark-slides",
        "lark-task",
        "lark-vc",
        "lark-vc-agent",
        "lark-whiteboard",
        "lark-wiki",
        "lark-workflow-meeting-summary",
        "lark-workflow-standup-report",
        "lark-worklog",
        "managing-lark-project-folder"
      ]
    }
  }
}
